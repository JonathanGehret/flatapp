{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "web",
    "ignore": ["**/.*"],
    "headers": [
      {
        "source": "**/*.@(js|css|html|webmanifest)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "emulators": {
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "hosting": { "host": "127.0.0.1", "port": 5000 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
